# ===== DROPIFY BACKEND CONFIGURATION =====
# Copy to .env and fill in your values.

# --- App ---
DEBUG=True
SECRET_KEY=change-me-please-32-chars-minimum-length
ACCESS_TOKEN_EXPIRE_DAYS=7

# --- Database (Docker Compose uses these defaults) ---
DATABASE_URL=postgresql://dropify:dropify_pass@db:5432/dropify

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0

# --- AI Providers (optional but recommended) ---
# Get keys at console.anthropic.com and platform.openai.com
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Payments (Stripe - optional at MVP; without it, milestones settle in demo mode) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
# Used to build Stripe Checkout success/cancel redirect URLs
FRONTEND_URL=http://localhost:3000

# --- n8n automation (self-hosted workflow engine) ---
# Webhook base URL reachable from the API container (docker network)
N8N_WEBHOOK_URL=http://n8n:5678/webhook
# HMAC secret shared with n8n workflows (any long random string)
N8N_WEBHOOK_SECRET=change-me-n8n-webhook-secret
# API key for n8n -> DROPIFY /api/n8n/trigger calls
N8N_INBOUND_KEY=change-me-n8n-inbound-key

# --- Email (SendGrid / SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SENDER_EMAIL=noreply@dropify.app

# --- CORS: frontend origins ---
CORS_ORIGINS=["http://localhost:3000","https://your-domain.vercel.app","https://dropify.app"]

# --- Business ---
PLATFORM_FEE_RATE=0.08
# Dynamic fee (#8): top-rated 5%, new 12%
FEE_RATE_TOP=0.05
FEE_RATE_NEW=0.12
TOP_RATING_MIN=4.8
TOP_RATING_COUNT_MIN=20
NEW_RATING_COUNT_MAX=3
# Referral 2.0 (#15): 2% level-1, 1% level-2, 12-month window
REFERRAL_RATE_L1=0.02
REFERRAL_RATE_L2=0.01
REFERRAL_MONTHS=12

# --- Admin bootstrap ---
ADMIN_EMAIL=admin@dropify.app
ADMIN_PASSWORD=admin123

# --- Demo data ---
SEED_DEMO_DATA=False

# --- Automation ---
DAILY_SUMMARY_ENABLED=True
