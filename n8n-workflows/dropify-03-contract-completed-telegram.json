      "parameters": {
        "httpMethod": "POST",
        "path": "dropify-job-completed",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "webhook-3",
      "name": "Webhook: dropify-job-completed",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "dropify-job-completed-03"
    },
